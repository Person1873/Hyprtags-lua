{
  "schemaVersion": 1,
  "id": "person1873.hyprtags",
  "name": "Hyprtags",
  "version": "0.1.0",
  "author": "person1873",
  "description": "DWM-style tag indicators driven by the hyprtags Hyprland Lua module",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Tags.qml"
  },
  "barWidget": {
    "displayName": "Tags",
    "description": "DWM-style tags (hides empty tags)",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "ntags": 9
    },
    "schema": [
      { "key": "ntags", "type": "number", "label": "Number of tags" }
    ]
  }
}
