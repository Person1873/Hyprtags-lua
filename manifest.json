{
  "schemaVersion": 1,
  "id": "person1873.hyprtags",
  "name": "Hyprtags",
  "version": "0.1.0",
  "author": "Person1873",
  "description": "DWM-style tags for Hyprland (Lua module + bar widget)",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "shell/Tags.qml"
  },
  "barWidget": {
    "displayName": "Tags",
    "description": "DWM-style tags (hides empty tags)",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "ntags": 21
    },
    "schema": [
      {
        "key": "ntags",
        "type": "number",
        "label": "Number of tags"
      }
    ]
  }
}
